# ===== 音频 / 录音文件（体积大，不进版本库）=====
# 录音文件仅保存在本地 audio/ 目录，通过 .gitkeep 保留目录结构
*.mp3
*.wav
*.m4a
*.aac
*.ogg
*.flac
*.wma
*.opus
*.amr
*.3gp
*.webm
*.mp4
*.mov

# ===== 压缩包 / 大附件 =====
*.zip
*.rar
*.7z
*.tar
*.gz

# ===== 系统 / 临时文件 =====
Thumbs.db
.DS_Store
~$*
*.tmp

# ===== Python =====
__pycache__/
*.pyc

# ===== 本地密钥配置（API Key 不入库）=====
.env

# ===== Reasonix 工具运行元数据（会话日志、任务快照）=====
.reasonix/

# ===== 会议数据（隐私：不入库，仅保留目录结构 .gitkeep）=====
# 会议音频、转写、纪要、属性、议程均含会议内容，一律不纳入 git
# （含项目内可能出现的自定义数据目录，如 会议仓库2/ 等——统一忽略数据文件）
meetings/**
!meetings/**/
!meetings/**/.gitkeep
会议仓库2/**
!会议仓库2/**/
!会议仓库2/**/.gitkeep
