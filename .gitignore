*.mp3
*.wav
*.m4a
*.aac
*.ogg
*.flac
*.wma
*.opus
*.amr
*.3gp
*.webm
*.mp4
*.mov

# ===== 压缩包 / 大附件 =====
*.zip
*.rar
*.7z
*.tar
*.gz

# ===== 系统 / 临时文件 =====
Thumbs.db
.DS_Store
~$*
*.tmp

# ===== Python =====
__pycache__/
*.pyc

# ===== Reasonix 工具运行元数据（会话日志、任务快照）=====
.reasonix/
